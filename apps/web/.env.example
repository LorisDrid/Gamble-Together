# Web app (Next.js) — copy to .env and adjust.
#
# URL of the game server. NEXT_PUBLIC_ vars are inlined at BUILD time, so this
# must be set before `next build` (or in the Vercel/Docker build env).
#   local:         http://localhost:3001
#   Vercel+Render:  https://your-server.onrender.com
#   mini PC:        https://gamble-together.lorisdrid.fr  (Caddy proxies /socket.io)
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# Persistence UI (returning-player stats + leaderboard). Default ON.
# Set to "false" on a host with an ephemeral DB (free cloud tier) so the stats
# don't show numbers that reset on every restart. Remove it when self-hosting.
# NEXT_PUBLIC_STATS_ENABLED=false
