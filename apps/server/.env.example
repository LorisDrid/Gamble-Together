# Game server (Node + Socket.io) — copy to .env and adjust.

# Port the server listens on. On Render this is injected automatically.
PORT=3001

# Exact origin allowed to connect (the web app's URL). No trailing slash.
#   local:         http://localhost:3000
#   Vercel+Render:  https://your-app.vercel.app
#   mini PC:        https://gamble-together.lorisdrid.fr
CORS_ORIGIN=http://localhost:3000

# SQLite file (node:sqlite). Use an absolute path on a mounted volume in prod.
#   docker:  /data/gamble.db
#   Render:  /var/data/gamble.db (paid disk) — omit on free tier (ephemeral)
DB_PATH=gamble.db
